<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spacing scale (multiples of 4dp, as in Material 3). -->
    <dimen name="spacing_xsmall">4dp</dimen>
    <dimen name="spacing_small">8dp</dimen>
    <dimen name="spacing_medium">16dp</dimen>
    <dimen name="spacing_large">24dp</dimen>
    <dimen name="spacing_xlarge">32dp</dimen>

    <!-- Accessibility: every touch target is at least 48dp. -->
    <dimen name="touch_target_min">48dp</dimen>

    <!-- Forms and text stay readable on wide screens (tablets, landscape). -->
    <dimen name="content_max_width">560dp</dimen>

    <dimen name="icon_large">48dp</dimen>

    <!-- Small labels drawn over the picture on the Image Scale screen. -->
    <dimen name="overlay_corner_radius">16dp</dimen>
    <dimen name="overlay_padding_horizontal">12dp</dimen>
    <dimen name="overlay_padding_vertical">6dp</dimen>

    <!-- Audio screen artwork (smaller in landscape). -->
    <dimen name="audio_artwork_size">160dp</dimen>
    <dimen name="audio_artwork_icon_size">72dp</dimen>

    <!-- Battery screen (smaller in landscape, see values-land/dimens.xml). -->
    <dimen name="battery_indicator_size">200dp</dimen>
    <dimen name="battery_indicator_thickness">12dp</dimen>
</resources>
