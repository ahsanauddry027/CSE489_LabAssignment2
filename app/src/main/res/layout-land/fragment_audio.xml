<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape version of the Audio screen: artwork on the left, title and controls on the
    right, so Play/Pause stays visible on a short screen. It has the same view IDs as the
    portrait layout, which lets one ViewBinding class serve both.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".audio.AudioFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/artwork_card"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="@dimen/audio_artwork_size"
            android:layout_height="@dimen/audio_artwork_size"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/track_title"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="@dimen/audio_artwork_icon_size"
                android:layout_height="@dimen/audio_artwork_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_music_note_24"
                app:tint="?attr/colorOnPrimaryContainer" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/track_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xlarge"
            android:text="@string/audio_track_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            app:layout_constraintBottom_toTopOf="@id/track_artist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/artwork_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="@dimen/content_max_width" />

        <TextView
            android:id="@+id/track_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:text="@string/audio_track_artist"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toTopOf="@id/seek_slider"
            app:layout_constraintEnd_toEndOf="@id/track_title"
            app:layout_constraintStart_toStartOf="@id/track_title"
            app:layout_constraintTop_toBottomOf="@id/track_title" />

        <com.google.android.material.slider.Slider
            android:id="@+id/seek_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:contentDescription="@string/audio_seek_description"
            android:valueFrom="0"
            android:valueTo="1"
            app:layout_constraintBottom_toTopOf="@id/elapsed_time"
            app:layout_constraintEnd_toEndOf="@id/track_title"
            app:layout_constraintStart_toStartOf="@id/track_title"
            app:layout_constraintTop_toBottomOf="@id/track_artist" />

        <TextView
            android:id="@+id/elapsed_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toTopOf="@id/controls"
            app:layout_constraintStart_toStartOf="@id/seek_slider"
            app:layout_constraintTop_toBottomOf="@id/seek_slider"
            tools:text="01:23" />

        <TextView
            android:id="@+id/total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBaseline_toBaselineOf="@id/elapsed_time"
            app:layout_constraintEnd_toEndOf="@id/seek_slider"
            tools:text="06:12" />

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/audio_status"
            app:layout_constraintStart_toStartOf="@id/track_title"
            app:layout_constraintTop_toBottomOf="@id/elapsed_time">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/play_pause_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audio_play"
                app:icon="@drawable/ic_play_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stop_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:text="@string/audio_stop"
                app:icon="@drawable/ic_stop_24" />
        </LinearLayout>

        <TextView
            android:id="@+id/audio_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/track_title"
            app:layout_constraintStart_toStartOf="@id/track_title"
            app:layout_constraintTop_toBottomOf="@id/controls"
            tools:text="@string/audio_playing" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
