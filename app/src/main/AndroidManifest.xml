<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed by Coil to download the picture on the Image Scale screen. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        enableOnBackInvokedCallback opts Android 13-15 into predictive back as well (it is the
        default from Android 16 with targetSdk 36+), so Back behaves the same everywhere.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LabAssignment2_CSE489"
        tools:targetApi="33">

        <!-- The only exported activity: the launcher entry point. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Activity 2 and Activity 3 of the broadcast flow. Only this app starts them, with
            explicit Intents, so they are not exported. adjustResize makes the system send IME
            insets, which Activity 2 uses to keep its text field above the keyboard.
        -->
        <activity
            android:name=".broadcast.BroadcastInputActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".broadcast.CustomReceiverActivity"
            android:exported="false" />
    </application>

</manifest>
